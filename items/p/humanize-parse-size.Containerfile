# Prepared image for item humanize-parse-size: agent-server + python-humanize test dependencies at the base commit.
# The repository itself is NOT installed; tests import it from the checkout via PYTHONPATH=src
# (src/humanize/_version.py is generated by hatch-vcs at install time, so test commands create it when missing).
FROM ghcr.io/openhands/agent-server:1.58.2-python
USER root
# humanize declares unpinned test extras; these are the versions resolved on 2026-10-26.
RUN pip install --no-cache-dir "freezegun==1.5.5" "pytest==9.1.1" "pytest-benchmark==5.3.0" "pytest-codspeed==5.0.3" \
      "pytest-cov==7.1.0" "coverage==7.17.0" \
 && python -m pytest --version
USER openhands
